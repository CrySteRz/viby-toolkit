{
  "manifest_version": 2,
  "name": "Viby Browser",
  "version": "0.10.1",
  "description": "Lets viby-toolkit drive this browser for Claude Code, through native messaging.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": [
    "tabs",
    "activeTab",
    "nativeMessaging",
    "storage",
    "webNavigation",
    "downloads",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "browser_action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Viby Browser - Idle",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "browser@viby-toolkit",
      "strict_min_version": "91.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
