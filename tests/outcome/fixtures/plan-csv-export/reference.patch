diff --git a/contacts/export.py b/contacts/export.py
new file mode 100644
index 0000000..334b112
--- /dev/null
+++ b/contacts/export.py
@@ -0,0 +1,21 @@
+"""CSV export: RFC 4180 quoting, CRLF line endings, and a guard against spreadsheet formulas."""
+import csv
+import io
+
+HEADER = ["id", "name", "email", "company", "tags", "created_at"]
+FORMULA_PREFIXES = ("=", "+", "-", "@")
+
+
+def _cell(value):
+    text = "" if value is None else str(value)
+    return "'" + text if text.startswith(FORMULA_PREFIXES) else text
+
+
+def to_csv(contacts):
+    out = io.StringIO()
+    writer = csv.writer(out, lineterminator="\r\n")
+    writer.writerow(HEADER)
+    for c in contacts:
+        row = [c.id, c.name, c.email, c.company, ";".join(c.tags), c.created_at.date().isoformat()]
+        writer.writerow([_cell(v) for v in row])
+    return out.getvalue()
