diff --git a/webhooks/retry.py b/webhooks/retry.py
new file mode 100644
index 0000000..e224e7e
--- /dev/null
+++ b/webhooks/retry.py
@@ -0,0 +1,17 @@
+"""How often and how long to wait before re-sending a webhook."""
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class RetryPolicy:
+    max_attempts: int = 5
+    base_delay: float = 0.5
+    max_delay: float = 30.0
+
+    def delay(self, n):
+        """Seconds to wait before the n-th retry (n starts at 1)."""
+        return min(self.max_delay, self.base_delay * 2 ** (n - 1))
+
+
+def retryable_status(status):
+    return status == 429 or 500 <= status < 600
